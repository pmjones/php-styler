{
    "name": "pmjones/php-styler",
    "description": "Companion to PHP-Parser that rebuilds PHP code from AST.",
    "keywords": [
        "code",
        "coding",
        "beautifier",
        "beautify",
        "format",
        "formatter",
        "guide",
        "parser",
        "php",
        "standard",
        "style",
        "styler"
    ],
    "license": "BSD-3-Clause",
    "autoload": {
        "psr-4" : {
            "PhpStyler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "PhpStyler\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.4",
        "pmjones/auto-shell": "^1.0"
    },
    "require-dev": {
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "bin": [
        "bin/php-styler"
    ],
    "scripts": {
        "analyze": "./vendor/bin/phpstan --memory-limit=256M",
        "check": "composer test && composer analyze && composer cs-check",
        "cs-check": "php bin/php-styler check",
        "cs-fix": "php bin/php-styler apply",
        "cs-preview": "php bin/php-styler preview",
        "test": "./vendor/bin/phpunit",
        "test-coverage": "./vendor/bin/phpunit --coverage-html=./tmp/coverage"
    }
}
