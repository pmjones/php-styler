{
    "name": "pmjones/php-styler",
    "description": "Companion to PHP-Parser that rebuilds PHP code from AST.",
    "keywords": [
        "code",
        "coding",
        "beautifier",
        "beautify",
        "format",
        "formatter",
        "guide",
        "parser",
        "php",
        "standard",
        "style",
        "styler"
    ],
    "license": "MIT",
    "autoload": {
        "files": ["src/compat.php"],
        "psr-4" : {
            "PhpStyler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4" : {
            "PhpStyler\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.1",
        "pmjones/auto-shell": "^1.0"
    },
    "require-dev": {
        "pds/composer-script-names": "^1.0",
        "pds/skeleton": "^1.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "bin": [
        "bin/php-styler"
    ],
    "scripts": {
        "analyze": "./vendor/bin/phpstan --memory-limit=256M",
        "check": "composer test && composer analyze && composer cs-clear && composer cs-check",
        "cs-check": "php bin/php-styler check --workers=auto",
        "cs-fix": "php bin/php-styler apply --workers=auto",
        "cs-preview": "php bin/php-styler preview",
        "cs-clear": "php bin/php-styler clear-cache",
        "test": "./vendor/bin/phpunit",
        "test-coverage": "./vendor/bin/phpunit --coverage-html=./tmp/coverage"
    }
}
